import { I18n } from "../i18n.slint";
import { Theme, Glyph, Icon } from "../primitives/primitives.slint";
import { SourcePreview } from "source-preview.slint";

// The library's Music page: 1,191 whole CC0 background tracks over two
// shelves - FreePD (the Internet Archive's mirror of Kevin MacLeod's CC0
// library) and Lo-Fi (Moby's MobyGratis instrumentals, as the OpenLo-Fi
// pack) - searched in a local catalog, fetched one track at a time.
//
// A track's bytes never arrive until they are asked for - a click
// previews one, a plus lays one at the playhead - and the Lo-Fi zip is
// never downloaded at all: each of its tracks is one ranged read of
// exactly that track's span out of the pack's 554 MB zip. What the page
// needs once is the two catalogs, a few MB, which the status card offers
// to load and then keeps out of the way.
//
// One global for the page's data and verbs, read by the desk's library
// pane, so nothing has to thread it through a seat.

/// One track, as a row shows it. Everything is display-ready: the numbers
/// arrive as words, because a card is a picture of a track rather than a
/// record of one.
export struct MusicCardData {
    /// The track's id in the library, as the verbs take it back.
    id: string,
    /// What the card says: the track's own title.
    title: string,
    /// "Kevin MacLeod · Upbeat" - who made it and the shelf's own
    /// grouping, one line.
    detail: string,
    /// "94s · 2.7 MB · FreePD" - the shape of the track, technical.
    meta: string,
    /// The track's file is already on this machine.
    ready: bool,
    /// Its bytes are coming down now. Tracks are a few MB, so a mark
    /// rather than a bar: the fetch is over before a bar has said
    /// anything.
    busy: bool,
}

export global Music {
    /// The search field's words, held here so the page's controls and the
    /// Rust side read one thing.
    in-out property <string> query;
    /// The shelves: 0 All, 1 FreePD, 2 Lo-Fi.
    in-out property <int> source;
    /// The category: 0 Any, then `categories`' order.
    in-out property <int> category;
    /// 0 Relevance, 1 Shortest, 2 Longest, 3 Surprise me.
    in-out property <int> order;
    /// 0 the catalogs are not on this machine yet, 1 a load running,
    /// 2 a shelf ready, 3 both shelves failed, with `error` saying why.
    in property <int> state;
    /// How far the Lo-Fi census has got, 0-100: the one-time measuring
    /// of every track's place and length in the pack's zip.
    in property <int> percent;
    /// The words that go with a state that is not ready.
    in property <string> error;
    /// How many tracks each shelf holds, once ready, with their
    /// thousands separated: "1,025" and "166".
    in property <string> freepd-rows;
    in property <string> lofi-rows;
    /// A search is running.
    in property <bool> searching;
    /// The tracks on the page, in the order the sort put them.
    in property <[MusicCardData]> results;
    /// How many tracks match in all, formatted, this page aside.
    in property <string> total;
    /// Whether another page of results waits behind the More button.
    in property <bool> more;
    /// Both shelves' own groupings, as the category filter lists them
    /// after "Any": "Upbeat", "Late-night", ... .
    in property <[string]> categories;

    /// "Load the music library": the one-time fetch of both shelves'
    /// catalogs.
    callback download();
    /// A library pane turned to the page or away from it, so a status
    /// read - are the catalogs here yet? - happens as the page comes up.
    callback shown(on: bool);
    /// The search field's words changed, or a filter moved: run it
    /// again, with every filter the page holds as it stands.
    callback search(query: string, source: int, category: int, order: int);
    /// The next page of what the last search found.
    callback more-loaded();
    /// A card clicked: preview the track, fetching it first if need be.
    callback preview(id: string);
    /// A card's plus: lay the track at the playhead, fetching it first.
    callback add(id: string);
}

// A small square button on a row: the plus.
component RowButton inherits Rectangle {
    in property <Glyph> glyph;
    callback clicked();

    width: 22px;
    height: 22px;
    border-radius: Theme.r-xs;
    background: touch.has-hover ? Theme.accent : Theme.field;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 11px;
        tint: touch.has-hover ? Theme.on-accent : Theme.fg-muted;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One track: a note in a well, the title over who made it and its
// grouping over the technical line, and the plus. A click previews; the
// plus lays it at the playhead.
export component MusicRow inherits Rectangle {
    in property <MusicCardData> item;
    callback preview();
    callback add();

    property <bool> playing-row: SourcePreview.card == root.item.id && root.item.id != "";
    property <bool> playing: root.playing-row && SourcePreview.playing;

    height: 64px;
    border-radius: Theme.r-sm;
    background: root.playing-row ? Theme.field-active
        : touch.has-hover ? Theme.field-hover : Colors.transparent;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Theme.r-sm;
                background: Theme.kind-audio-well;

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    glyph: root.item.busy ? Glyph.import
                        : root.item.ready ? Glyph.play : Glyph.music;
                    size: parent.width * 0.42;
                    tint: Theme.kind-audio;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.item.title;
                color: Theme.fg;
                font-size: Theme.fs-sm;
                overflow: elide;
            }
            Text {
                text: root.item.detail;
                color: Theme.fg-dim;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            Text {
                text: root.item.meta;
                color: Theme.fg-muted;
                font-family: Theme.font-technical;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            RowButton {
                glyph: Glyph.plus;
                clicked => { root.add(); }
            }
        }
    }

    // How far the one playing has got, as a line along its foot.
    if root.playing-row: Rectangle {
        x: 0;
        y: parent.height - 2px;
        width: parent.width * Math.clamp(SourcePreview.progress, 0, 1);
        height: 2px;
        background: Theme.accent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.preview(); }
    }
}

// The rows, one after another, reached by the page's own scroll.
export component MusicList inherits Rectangle {
    in property <[MusicCardData]> items;

    VerticalLayout {
        padding: 0;
        spacing: 1px;

        for item in root.items: MusicRow {
            item: item;
            preview => { Music.preview(item.id); }
            add => { Music.add(item.id); }
        }
    }
}

// The status card: what stands between the person and the library, said
// in words, with the one button that moves it along.
export component MusicStatus inherits Rectangle {
    border-radius: Theme.r;
    background: Theme.field;
    height: 200px;

    VerticalLayout {
        alignment: center;
        padding: 16px;
        spacing: 10px;

        if Music.state == 0 || Music.state == 3: VerticalLayout {
            alignment: center;
            spacing: 10px;

            Text {
                text: I18n.t("bgm.welcome");
                color: Theme.fg;
                font-size: Theme.fs;
                horizontal-alignment: center;
            }
            Text {
                text: I18n.t("bgm.welcomeHint");
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            if Music.state == 3: Text {
                text: Music.error;
                color: Theme.danger;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            Rectangle {
                border-radius: Theme.r-sm;
                height: Theme.h;
                background: start.has-hover ? Theme.accent-hover : Theme.accent;
                HorizontalLayout {
                    alignment: center;
                    Text {
                        vertical-alignment: center;
                        text: I18n.t("bgm.download");
                        color: Theme.on-accent;
                        font-size: Theme.fs-sm;
                    }
                }
                start := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Music.download(); }
                }
            }
        }

        if Music.state == 1: VerticalLayout {
            alignment: center;
            spacing: 10px;

            Text {
                text: I18n.t("bgm.loading");
                color: Theme.fg;
                font-size: Theme.fs;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.line;
                clip: true;

                Rectangle {
                    x: 0;
                    y: 0;
                    height: parent.height;
                    width: parent.width * Math.min(100, Math.max(0, Music.percent)) / 100;
                    border-radius: 3px;
                    background: Theme.accent;
                }
            }
            Text {
                text: "\{Music.percent}% · \{I18n.t("bgm.freepd")} \{Music.freepd-rows} · \{I18n.t("bgm.lofi")} \{Music.lofi-rows}";
                color: Theme.fg-muted;
                font-family: Theme.font-technical;
                font-size: Theme.fs-sm;
                horizontal-alignment: center;
            }
        }
    }
}
