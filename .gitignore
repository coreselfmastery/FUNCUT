ssh.sh

## Do not remove these
test/assets/
test/assets/*

# Rust
target/
**/target/
*.pdb

# Nix build output
/result
/result-*

# Python (tooling and one-off scripts live at the repo root for now)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# The analysis tools' synthetic fixtures: made by
# src/crates/concat-api/analysis/tests/make_test_media.sh, never committed.
src/crates/concat-api/analysis/tests/test_media/

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Scratch media at the repo root.
#
# Test clips are large and change constantly, so they do not belong in git
# history. Fixtures that tests genuinely depend on should live in a `fixtures/`
# directory next to those tests and be committed deliberately - this pattern
# only covers loose files dropped at the top level.
/*.mp4
/*.mov
/*.mkv
/*.webm
/*.mp3
/*.wav
/*.flac
/*.aac
/scratch_*

# Local environment
.env
.env.local

# An FFmpeg development build unpacked locally for the linked engine
# (headers + import libraries), pointed at with FFMPEG_DIR. Large and
# machine-specific.
/vendor/
/ffmpeg-dev/
# The archives scripts/ci/fetch.sh downloads for a local build -
# ffmpeg.tar.xz, onnxruntime.tgz, sherpa.tar.bz2 - are a warm machine's
# cache: kept so a rerun downloads nothing, never part of the tree.
/ffmpeg.tar.xz
/onnxruntime.tgz
/sherpa.tar.bz2
# FFmpeg built for a phone by src/scripts/ffmpeg-mobile.sh: sources,
# build trees and the installed prefixes, all machine-built.
/src/vendor/
