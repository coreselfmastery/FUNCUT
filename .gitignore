ssh.sh

## Do not remove these
test/assets/
test/assets/*

# Rust
target/
**/target/
*.pdb

# Nix build output
/result
/result-*

# Python (tooling and one-off scripts live at the repo root for now)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# The analysis tools' synthetic fixtures: made by
# src/crates/concat-api/analysis/tests/make_test_media.sh, never committed.
src/crates/concat-api/analysis/tests/test_media/

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Scratch media at the repo root.
#
# Test clips are large and change constantly, so they do not belong in git
# history. Fixtures that tests genuinely depend on should live in a `fixtures/`
# directory next to those tests and be committed deliberately - this pattern
# only covers loose files dropped at the top level.
/*.mp4
/*.mov
/*.mkv
/*.webm
/*.mp3
/*.wav
/*.flac
/*.aac
/scratch_*

# Local environment
.env
.env.local

# An FFmpeg development build unpacked locally for the linked engine
# (headers + import libraries), pointed at with FFMPEG_DIR. Large and
# machine-specific.
/vendor/
/ffmpeg-dev/
# The archives scripts/ci/fetch.sh downloads for a local build -
# ffmpeg.tar.xz, onnxruntime.tgz, sherpa.tar.bz2 - are a warm machine's
# cache: kept so a rerun downloads nothing, never part of the tree.
/ffmpeg.tar.xz
/onnxruntime.tgz
/sherpa.tar.bz2

# The motion example's render scratch: scripts/motion/layers-assets.py
# writes the assets and the render fills the cache - both are outputs,
# never inputs, and a warm one on a contributor's machine is not a
# change to the reel.
check/
# The CI dependency set this checkout fetched and verified (deps.lock):
# the ffmpeg-dev and onnxruntime extracts, warm-machine archives.
/onnxruntime-linux-x64-*/
/onnxruntime-linux-aarch64-*/
# The sherpa-onnx extract the same fetch unpacks (the CI engine job and
# scripts/setup-build-env.sh both land it here), and the no-root clang
# that script's --debs unpacks: both machine-built, never committed.
/sherpa/
/sysroot/


# The apt packages setup-build-env.sh unpacks and the cmake/clang tree it
# builds them into: machine-built, fetched per checkout, never committed.
/.debs/
/.deps/
# The local build environment: the extracts scripts/setup-build-env.sh
# fetches, and the Geneva sidecar deps.lock pulls in. Never committed.
/geneva/
/ffmpeg-dev/
/ffmpeg.tar.xz
/onnxruntime-linux-x64-*/
/sherpa/
/sysroot/
/sysroot-extra/

# the onnxruntime shared libs extracted for local builds
/.ort-shared/
