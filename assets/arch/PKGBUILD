# Maintainer: noxygalaxy <noxycraftyt@gmail.com>
pkgname=concat
pkgver=${CONCAT_VERSION:?CONCAT_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
url="https://github.com/jub0t/Concat"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${CONCAT_STAGE:?CONCAT_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/concat" "$pkgdir/opt/concat/concat"
  install -Dm755 "$stage/geneva" "$pkgdir/opt/concat/geneva"
  install -Dm755 "$stage/concat-motion-agent" "$pkgdir/opt/concat/concat-motion-agent"
  install -d "$pkgdir/opt/concat/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/concat/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/concat/concat "$@"\n' > "$pkgdir/usr/bin/concat"
  chmod 755 "$pkgdir/usr/bin/concat"
  printf '#!/bin/sh\nexec /opt/concat/concat-motion-agent "$@"\n' > "$pkgdir/usr/bin/concat-motion-agent"
  chmod 755 "$pkgdir/usr/bin/concat-motion-agent"
  # The motion sidecar beside the executable, where Geneva::discover looks.
  ln -s /opt/concat/geneva "$pkgdir/usr/bin/geneva"
  install -Dm644 "$stage/concat.desktop" "$pkgdir/usr/share/applications/concat.desktop"
  sed -i 's|^Exec=concat|Exec=/opt/concat/concat %U|' "$pkgdir/usr/share/applications/concat.desktop"
  # Every icon size the stage carries (assets/icons is the source), so a
  # tray, a dock and a start menu each get the size they ask for.
  for size in 16 32 64 128 256 512; do
    install -Dm644 "$stage/icons/hicolor/${size}x${size}/apps/concat.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/concat.png"
  done
  # The AppStream metainfo GNOME Software and Discover read.
  install -Dm644 "$stage/metainfo/concat.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/concat.metainfo.xml"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/concat/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/concat/THIRD_PARTY_NOTICES.md"
}
